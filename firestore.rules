rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function owner() { return signedIn() && resource.data.ownerId == me(); }
    function itemExists(id) { return exists(/databases/$(database)/documents/items/$(id)); }
    function itemData(id) { return get(/databases/$(database)/documents/items/$(id)).data; }
    function validItem(d) {
      return d.keys().hasOnly(['ownerId','type','title','category','location','eventDate','description','imageUrl','status','createdAt','updatedAt'])
        && d.ownerId is string && d.type in ['Lost','Found']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.description is string && d.description.size() > 0 && d.description.size() <= 600
        && d.category in ['ID Cards','Electronics','Bags','Keys','Wallets','Books','Accessories','Other']
        && d.location in ['Library','Canteen','Classrooms','Computer Labs','Electronics Labs','Auditorium','Parking','Corridors','Main Entrance','Other']
        && d.eventDate is string && d.eventDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.imageUrl is string && (d.imageUrl == '' || d.imageUrl.matches('https://res[.]cloudinary[.]com/[^/]+/image/upload/.*'))
        && d.status in ['Open','Closed']
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }
    // Public name directory. Not a listable user directory. Existing name-only
    // records are readable for backward compatibility until the owner edits privacy.
    // Email can be shared ONLY when explicitly enabled by the account owner.
    match /publicNames/{userId} {
      function visible() {
        return !('showProfile' in resource.data) || resource.data.showProfile == true;
      }
      function validPublicName(d) {
        return d.keys().hasOnly(['name','showProfile','showEmail','email'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && (!('showProfile' in d) || d.showProfile is bool)
          && (!('showEmail' in d) || d.showEmail is bool)
          && (!('email' in d) || d.email is string)
          && (!('showEmail' in d) || d.showEmail == false
            || ('showProfile' in d && d.showProfile == true
              && 'email' in d && d.email == request.auth.token.email))
          && (!('email' in d) || d.email == ''
            || ('showEmail' in d && d.showEmail == true
              && 'showProfile' in d && d.showProfile == true
              && d.email == request.auth.token.email));
      }
      allow get: if signedIn() && (me() == userId || visible());
      allow list: if false;
      allow create, update: if signedIn() && me() == userId
        && validPublicName(request.resource.data);
      allow delete: if signedIn() && me() == userId;
    }
    match /users/{userId} {
      allow read, write: if signedIn() && me() == userId
        && (request.method in ['get','list','delete'] || (
          request.resource.data.keys().hasOnly(['uid','name','email','photoURL','college','branch','academicYear','rollNumber','updatedAt'])
          && request.resource.data.uid == me()
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.photoURL is string
          && (!('college' in request.resource.data) || request.resource.data.college == 'PICT')
          && (!('branch' in request.resource.data) || (request.resource.data.branch is string && request.resource.data.branch.size() <= 80))
          && (!('academicYear' in request.resource.data) || request.resource.data.academicYear in ['First Year','Second Year','Third Year','Fourth Year'])
          && (!('rollNumber' in request.resource.data) || (request.resource.data.rollNumber is string && request.resource.data.rollNumber.size() <= 25))));
    }
    match /items/{itemId} {
      allow get, list: if resource.data.status == 'Open' || owner();
      allow create: if signedIn() && request.resource.data.ownerId == me()
        && validItem(request.resource.data) && request.resource.data.status == 'Open'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if owner() && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && validItem(request.resource.data) && request.resource.data.updatedAt == request.time;
      allow delete: if owner();
    }
    match /conversations/{threadId} {
      function participant() { return signedIn() && me() in resource.data.participants; }
      allow get, list: if participant();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['itemId','participants','itemOwnerId','initiatorId','createdAt'])
        && request.resource.data.itemId is string
        && itemExists(request.resource.data.itemId)
        && itemData(request.resource.data.itemId).status == 'Open'
        && request.resource.data.itemOwnerId == itemData(request.resource.data.itemId).ownerId
        && request.resource.data.initiatorId == me()
        && me() != request.resource.data.itemOwnerId
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && me() in request.resource.data.participants
        && request.resource.data.itemOwnerId in request.resource.data.participants
        && threadId == request.resource.data.itemId + '_' + request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /messages/{messageId} {
        function thread() { return get(/databases/$(database)/documents/conversations/$(threadId)).data; }
        function inThread() { return signedIn() && me() in thread().participants; }
        allow get, list: if inThread();
        allow create: if inThread()
          && request.resource.data.keys().hasOnly(['senderId','text','createdAt'])
          && request.resource.data.senderId == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /claims/{claimId} {
      function involved() { return signedIn() && (resource.data.claimantId == me() || resource.data.itemOwnerId == me()); }
      allow get, list: if involved();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['itemId','itemOwnerId','claimantId','proof','status','createdAt'])
        && request.resource.data.itemId is string
        && itemExists(request.resource.data.itemId)
        && itemData(request.resource.data.itemId).status == 'Open'
        && itemData(request.resource.data.itemId).type == 'Found'
        && request.resource.data.itemOwnerId == itemData(request.resource.data.itemId).ownerId
        && request.resource.data.claimantId == me()
        && request.resource.data.itemOwnerId != me()
        && claimId == request.resource.data.itemId + '_' + me()
        && request.resource.data.proof is string
        && request.resource.data.proof.size() >= 10 && request.resource.data.proof.size() <= 500
        && request.resource.data.status == 'Pending'
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.itemOwnerId == me()
        && resource.data.status in ['Pending','Approved','Rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['Approved','Rejected']
        && request.resource.data.status != resource.data.status
        && (request.resource.data.status != 'Approved'
            || getAfter(/databases/$(database)/documents/items/$(resource.data.itemId)).data.status == 'Closed')
        && (resource.data.status != 'Approved' || request.resource.data.status != 'Rejected'
            || getAfter(/databases/$(database)/documents/items/$(resource.data.itemId)).data.status == 'Open');
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
